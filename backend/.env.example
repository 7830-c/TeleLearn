# Supabase PostgreSQL connection string (must use postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectid:YourPassword@aws-0-region.pooler.supabase.com:6543/postgres

# Telegram Auth Session Encryption Key (must be 32 url-safe base64-encoded bytes)
ENCRYPTION_KEY=your_generated_44_character_string_here

# (Optional) Telegram App API Credentials
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
